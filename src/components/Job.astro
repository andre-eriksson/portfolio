---
import type { Job } from "../data/jobs";
import "../styles/global.css";
const { job } = Astro.props as { job: Job };
---

<li
    class="w-full flex gap-2 border rounded-md border-yellow-400/20 shadow-sm shadow-yellow-400/20"
>
    <img src={job.imgSrc} class="size-24 p-1 bg-white rounded-md" />
    <div class="mt-auto w-full">
        <div class="flex gap-1 items-center justify-between">
            <h4 class="text-lg font-bold">
                {job.jobTitle}
            </h4>
            <div class="flex gap-1">
                <p class="text-neutral-600">{job.startDate}</p>
                <span>·</span>
                <p class="text-neutral-600">{job.endDate}</p>
            </div>
        </div>
        <p class="text-neutral-600 text-sm">
            {job.position}
        </p>
    </div>
</li>
