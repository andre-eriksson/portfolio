---
import type { Job } from "../data/jobs";
import "../styles/global.css";
const { job } = Astro.props as { job: Job };
---

<li class="w-full flex gap-4">
    <a href={job.jobLink} target="_blank" class="shrink-0">
        <img
            src={job.imgSrc}
            alt={job.jobTitle}
            class="size-12 rounded-sm border border-neutral-200 object-cover"
        />
    </a>
    <div class="w-full flex flex-col">
        <div class="flex justify-between items-baseline">
            <a
                href={job.jobLink}
                target="_blank"
                class="font-semibold text-neutral-900 hover:underline decoration-neutral-400 underline-offset-4"
            >
                {job.jobTitle}
            </a>
            <p
                class="google-sans-code-400 text-sm text-neutral-500 tabular-nums"
            >
                {job.startDate} - {job.endDate}
            </p>
        </div>
        <p class="text-neutral-600 text-sm">
            {job.position}
        </p>
        {
            job.points.map((point) => (
                <p class="text-neutral-700 text-sm mt-1 leading-relaxed">
                    &FilledVerySmallSquare; {point}
                </p>
            ))
        }
    </div>
</li>
