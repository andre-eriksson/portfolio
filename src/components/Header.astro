---
import Moon from "../assets/moon.svg";
import "../styles/global.css";
---

<section class="w-full h-fit flex justify-between">
    <section class="flex gap-8">
        <img src="./profile.jpg" class="size-32 rounded-sm" />
        <div class="mt-auto">
            <h1 class="text-4xl font-semibold tracking-tight">
                André Eriksson
            </h1>
            <p class="text-neutral-600">Software Engineer</p>
        </div>
    </section>
    <button class="h-fit hover:bg-neutral-300 p-2">
        <Moon />
    </button>
</section>
